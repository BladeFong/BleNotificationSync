{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BLE Notification Sync",
  "version": "0.1.0",
  "identifier": "com.ble-notification-sync.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BLE Notification Sync",
        "width": 700,
        "height": 550,
        "minWidth": 500,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
